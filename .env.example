# =============================================================================
# workspace-mcp — environment template
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored and MUST NEVER be committed. It holds the Google OAuth
# client secret, the JWT signing key that encrypts persisted OAuth state, and
# a Telegram bot token.
#
# WRITE IT DIRECTLY ON THE TARGET MACHINE. Do not paste secrets into a chat or
# an agent session — transcripts persist outside your control.
#
# Values set in the compose file's `environment:` block WIN over anything here,
# so this file only needs the uncommented entries below. The commented ones are
# documented defaults / escape hatches.
# =============================================================================

# --- Public identity (required) ----------------------------------------------
# The exact public origin this server is reached at: scheme + host, NO trailing
# slash, NO path, NO :443 suffix. It is string-concatenated into every OAuth
# metadata URL, so a trailing slash produces double slashes and breaks
# discovery. It is ALSO the origin the server trusts in its Origin-validation
# middleware, and default-port normalisation is NOT applied — "https://host"
# and "https://host:443" are different strings to it.
#
#   VPS   : https://workspace.example.com
#   local : http://localhost:8020
WORKSPACE_EXTERNAL_URL=https://workspace.example.com

# --- Google OAuth client (required) ------------------------------------------
# Google Cloud Console -> APIs & Services -> Credentials -> "Web application".
# Authorised redirect URIs must contain, EXACTLY:
#     https://workspace.example.com/oauth2callback     (production)
#     http://localhost:8020/oauth2callback             (local dev)
# The server derives that URI as WORKSPACE_EXTERNAL_URL + /oauth2callback, so
# there is normally no need to set GOOGLE_OAUTH_REDIRECT_URI at all (see below).
#
# The client SECRET is displayed only once, at creation time. Capture it
# straight into this file and keep an encrypted off-machine copy — it cannot be
# recovered from Google Cloud afterwards.
GOOGLE_OAUTH_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxx

# --- JWT signing key (required) ----------------------------------------------
# Generate ON the target machine, never elsewhere:
#     openssl rand -hex 32
#
# Two jobs: it signs the MCP access tokens, and it derives the Fernet key that
# encrypts the persisted OAuth-proxy state on disk. Left unset, that key is
# derived from GOOGLE_OAUTH_CLIENT_SECRET instead — which means rotating the
# client secret would orphan all stored state. Set it explicitly and TREAT IT
# AS STABLE.
#
# Changing or losing it is NOT graceful: the old ciphertext in the oauth-proxy
# directory then fails to decrypt and /authorize + /token return 500s rather
# than degrading to a re-auth prompt. Recovery = stop the container, empty
# store_creds/oauth-proxy/, start again, re-auth every client once. The Google
# credential files (store_creds/google/) are a different layer and survive.
FASTMCP_SERVER_AUTH_GOOGLE_JWT_SIGNING_KEY=

# --- Telegram alerting for the cron scripts (required if you use examples/) ---
# Read by examples/cron-reminder.sh and examples/deadman-check.sh, NOT by the
# server. A bot token from @BotFather and the target chat id (often negative
# for groups). The alert path deliberately talks straight to the Bot API so it
# still works when everything else on the box is down.
TELEGRAM_TOKEN=
TELEGRAM_CHAT=

# --- Account and defaults used by the example scripts ------------------------
# In OAuth 2.1 mode the SERVER ignores USER_GOOGLE_EMAIL (it is forced to None),
# so every tool call must carry user_google_email explicitly. These two exist so
# the example scripts and the skill have one place to read them from.
GOOGLE_ACCOUNT_EMAIL=you@gmail.com
REMINDER_TIMEZONE=Europe/Berlin

# --- workspace-cli (VPS cron path) -------------------------------------------
# Consumed by `workspace-cli`. Note the CLI requires --url BEFORE the
# subcommand, so exporting this variable instead of passing the flag is the
# safer habit in cron.
WORKSPACE_MCP_URL=https://workspace.example.com/mcp

# =============================================================================
# Everything below is already set in the compose files. Listed for reference —
# uncomment only to deviate deliberately.
# =============================================================================

# Listen port INSIDE the container. Set PORT, not WORKSPACE_MCP_PORT: the
# image's HEALTHCHECK is hardcoded to curl ${PORT:-8000}/health, so setting only
# WORKSPACE_MCP_PORT leaves a correctly-serving container permanently unhealthy.
#PORT=8020

# Bind address inside the container. With MCP_ENABLE_OAUTH21=true the default is
# already 0.0.0.0; without it the server quietly binds 127.0.0.1 and Caddy gets
# a connection refused. Set explicitly.
#WORKSPACE_MCP_HOST=0.0.0.0

# OAuth 2.1 multi-client mode — required for claude.ai custom connectors.
# ONLY the literal string "true" enables it (case-insensitive, NOT whitespace
# stripped). "1", "yes" and "true " all silently mean false.
#MCP_ENABLE_OAUTH21=true

# Which Google services to load, and how deep. TOOLS is consumed by the image's
# shell entrypoint and is SPACE-separated; a comma-separated value is passed as
# one token and argparse kills the container at startup. (The Python-level
# fallback WORKSPACE_MCP_TOOLS is COMMA-separated — do not mix the two up.)
# Valid service names: gmail drive calendar docs sheets chat forms slides tasks
# contacts search appscript.
#TOOLS=calendar tasks
#TOOL_TIER=core

# DCR redirect-URI allowlist. MANDATORY on a public endpoint: unset means the
# server accepts ANY client-supplied redirect URI during dynamic client
# registration, which is a code-harvesting vector. Comma-separated; `*` globs a
# port or path component. Keep BOTH claude.ai and claude.com, and keep the
# loopback patterns — dropping those breaks Claude Code (ephemeral local port)
# while leaving the web connector working, which is a confusing way to fail.
#WORKSPACE_MCP_ALLOWED_CLIENT_REDIRECT_URIS=https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost:*/callback,http://127.0.0.1:*/callback

# Extra browser origins accepted by the server's Origin-validation middleware.
# Requests with NO Origin header (ordinary server-to-server MCP traffic) always
# pass; requests carrying an unknown Origin get a 403. Claude's browser-side
# calls send Origin: https://claude.ai, which is not trusted by default, so
# allow it here. Comma-separated. Note the name has no WORKSPACE_MCP_ prefix.
#OAUTH_ALLOWED_ORIGINS=https://claude.ai,https://claude.com

# Where OAuth-proxy state (registered clients, sessions) is kept. The default is
# in-memory with no warning: every container restart would silently log out
# every client. "disk" needs an explicit directory on a persistent volume — its
# own default lives in the container's home directory, which is NOT on the
# volume. The `disk` extra is pre-installed in the official image.
#WORKSPACE_MCP_OAUTH_PROXY_STORAGE_BACKEND=disk
#WORKSPACE_MCP_OAUTH_PROXY_DISK_DIRECTORY=/app/store_creds/oauth-proxy

# Where Google refresh tokens are written (plaintext JSON, one file per
# account, 0600). WORKSPACE_MCP_CREDENTIALS_DIR is the current name;
# GOOGLE_MCP_CREDENTIALS_DIR is a legacy fallback read only if this is unset.
# Set one, never both.
#WORKSPACE_MCP_CREDENTIALS_DIR=/app/store_creds/google

# Only the PATH component of this is used, and it already defaults to
# WORKSPACE_EXTERNAL_URL + /oauth2callback. Setting it buys nothing and creates
# a second value to keep in sync — a stale local URL left here on the VPS is a
# real footgun. Leave it unset unless you deliberately move the callback path.
#GOOGLE_OAUTH_REDIRECT_URI=https://workspace.example.com/oauth2callback

# Branding shown on the server's own consent page.
#WORKSPACE_MCP_BRAND_NAME=workspace-mcp
#WORKSPACE_MCP_BRAND_WEBSITE_URL=https://workspace.example.com
